 parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="12  notify: endpoint disabled by the subscriber" vertex="1"><mxGeometry x="750" y="831" width="850" height="13" as="geometry"/></mxCell><mxCell id="m12" parent="1" style="html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="848" as="sourcePoint"/><mxPoint x="1610" y="848" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f772-db-adm-l" parent="1" style="html=1;fillColor=#161823;strokeColor=#ec4899;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#e6e8f0;align=left;spacingLeft=6;" value="alt  410 Gone" vertex="1"><mxGeometry x="349" y="772" width="98" height="18" as="geometry"/></mxCell><mxCell id="m13t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="13  move to dead-letter" vertex="1"><mxGeometry x="460" y="904" width="270" height="13" as="geometry"/></mxCell><mxCell id="m13" parent="1" style="html=1;strokeColor=#94a3b8;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="921" as="sourcePoint"/><mxPoint x="450" y="921" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="14  alert: deliveries failing for this endpoint" vertex="1"><mxGeometry x="750" y="939" width="850" height="13" as="geometry"/></mxCell><mxCell id="m14" parent="1" style="html=1;strokeColor=#94a3b8;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="9