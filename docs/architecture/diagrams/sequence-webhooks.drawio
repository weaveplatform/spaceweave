okeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="484" as="sourcePoint"/><mxPoint x="1320" y="484" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" parent="1" style="html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="506" as="sourcePoint"/><mxPoint x="1320" y="549" as="targetPoint"/><Array as="points"><mxPoint x="1348" y="506"/><mxPoint x="1348" y="549"/></Array></mxGeometry></mxCell><mxCell id="m7t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;verticalAlign=middle;" value="7  verify signature and timestamp tolerance; drop a webhook-id already seen" vertex="1"><mxGeometry x="1356" y="506" width="200" height="43" as="geometry"/></mxCell><mxCell id="m8t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="8  200 OK" vertex="1"><mxGeometry x="750" y="589" width="560" height="13" as="geometry"/></mxCell><mxCell id="m8" parent="1" style="html=1;strokeColor=#ec4899;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="606" as="sourcePoint"/><mxPoint x="740" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="9  mark delivered" vertex="1"><mxGeometry x="460" y="624" width="270" height="13" as="geometry"/></mxCell><mxCell id="m9" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mx