tandard Webhooks specification." vertex="1"><mxGeometry x="30" y="56" width="1740" height="40" as="geometry"/></mxCell><mxCell id="m1t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="1  UPDATE booking; INSERT DomainEvent; INSERT outbox (msg_id, endpoint, payload)" vertex="1"><mxGeometry x="170" y="224" width="270" height="26" as="geometry"/></mxCell><mxCell id="m1" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="254" as="sourcePoint"/><mxPoint x="450" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="2  COMMIT" vertex="1"><mxGeometry x="170" y="272" width="270" height="13" as="geometry"/></mxCell><mxCell id="m2" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="289" as="sourcePoint"/><mxPoint x="450" y="289" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f200-svc-db-l" parent="1" style="html=1;fillColor=#161823;strokeColor=#94a3b8;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#e6e8f0;align=left;spacingLeft=6;" value="one transaction" vertex="1"><mxGeometry x="59" y="200" width="111" height="18" as="geometry"/></mxCell><mxCell id="m3t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="3  claim due outbox rows (FOR UPDATE SKIP LOCKED)" vertex="1"><mxGeometry x="460" y="321" width="270" height="26" as="geometry"/></mxCell><mxCell id="m3" parent="1" style="html=1