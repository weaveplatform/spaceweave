<mxfile host="spaceweave-research"><diagram id="seq-webhooks" name="Outbox → webhook"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1820" pageHeight="1098" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f200-svc-db" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="59" y="200" width="492" height="107" as="geometry"/></mxCell><mxCell id="f565-d-sub" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#2ee6c5;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="639" y="565" width="782" height="94" as="geometry"/></mxCell><mxCell id="f673-db-sub" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#f5b13d;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="349" y="673" width="1072" height="85" as="geometry"/></mxCell><mxCell id="f772-db-adm" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#ec4899;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="349" y="772" width="1362" height="94" as="geometry"/></mxCell><mxCell id="f880-db-adm" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="349" y="880" width="1362" height="164" as="geometry"/></mxCell><mxCell id="ll-svc" parent="1" style="endArrow=none;html=1;dashed=1;dashPattern=3 4;strokeColor=#f87171;strokeWidth=1;opacity=70;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="170" as="sourcePoint"/><mxPoint x="160" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ll-db" parent="1" style="endArrow=none;html=1;dashed=1;dashPattern=3 4;strokeColor=#f87171;strokeWidth=1;opacity=70;" value="" edge="1"><mxGeometry relative="1"