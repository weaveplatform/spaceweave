200" width="480" height="40" as="geometry"/></mxCell><mxCell id="m1t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="1  user created and assigned to the spaceweave app" vertex="1"><mxGeometry x="170" y="282" width="270" height="26" as="geometry"/></mxCell><mxCell id="m1" parent="1" style="html=1;strokeColor=#94a3b8;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="312" as="sourcePoint"/><mxPoint x="450" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="2  GET /Users?filter=userName eq &amp;quot;ana@org&amp;quot;" vertex="1"><mxGeometry x="460" y="330" width="270" height="13" as="geometry"/></mxCell><mxCell id="m2" parent="1" style="html=1;strokeColor=#94a3b8;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="347" as="sourcePoint"/><mxPoint x="740" y="347" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="3  200, totalResults 0" vertex="1"><mxGeometry x="460" y="365" width="270" height="13" as="geometry"/></mxCell><mxCell id="m3" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="382" as="sourcePoint"/><mxPoint x="450" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fon