></mxCell><mxCell id="e10" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="cancelled before start (a required BookingLink cancels its partner)" edge="1" source="alloc" target="cancel"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e11" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="check-in window missed (check_in_required)" edge="1" source="alloc" target="noshow"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e12" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="end passed (no check-in required)" edge="1" source="alloc" target="done"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="876" y="240"/><mxPoint x="1555" y="240"/></Array></mxGeometry></mxCell><mxCell id="e13" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;" value="end passed" edge="1" source="taken" target="done"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e14" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="released early" edge="1" source="taken" target="released"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="foot" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A released or no-show resource goes back to supply: the waitlist is offered it, or the next top-up run places someone in it. Releasing an assigned desk for a day is an AssignmentRelease, not a booking state." vertex="1"><mxGeometry x="30" y="700" width="1600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sm-space-request" name="SpaceRequest"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1150" pageHeight="530" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="SpaceRequest lifecycle" vertex="1"><mxGeometry x="30" y="24" width="1500" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A space request asks for a kind of space, such as a height-adjustable desk, never a specific one. Requests the run cannot place join the single waitlist in the order they were made. If the person needs parking, a locker or a bike rack to come in at all, the request is placed only once that is secured too." vertex="1"><mxGeometry x="30" y="56" width="1500" height="36" as="geometry"/></mxCell><mxCell id="s0" parent="1" style="ellipse;html=1;fillColor=#2ee6c5;strokeColor=#2ee6c5;" value="" vertex="1"><mxGeometry x="30" y="162" width="16" height="16" as="geometry"/></mxCell><mxCell id="s0t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="requested" vertex="1"><mxGeometry x="22" y="136" width="80" height="14" as="geometry"/></mxCell><mxCell id="open" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;open&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;requested_at stamps the queue order&lt;/font&gt;" vertex="1"><mxGeometry x="130" y="150" width="170" height="58" as="geometry"/></mxCell><mxCell id="grouped" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;grouped&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;in a SeatingGroup&lt;/font&gt;" vertex="1"><mxGeometry x="400" y="150" width="170" height="58" as="geometry"/></mxCell><mxCell id="placed" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=3;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;placed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;Placement in a published plan&lt;/font&gt;" vertex="1"><mxGeometry x="760" y="150" width="170" height="58" as="geometry"/></mxCell><mxCell id="queued" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpac