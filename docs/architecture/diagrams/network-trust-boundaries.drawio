can allow-list them. The numbered trust boundaries are the ones the threat model uses." vertex="1"><mxGeometry x="30" y="56" width="2280" height="40" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="60" y="200" width="320" height="78" as="geometry"/></mxCell><mxCell id="a1-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="72" y="210" width="18" height="18" as="geometry"/></mxCell><mxCell id="a1-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Staff: browser, Teams app, Outlook add-in" vertex="1"><mxGeometry x="98" y="211" width="270" height="18" as="geometry"/></mxCell><mxCell id="a1-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="234" as="sourcePoint"/><mxPoint x="370" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a1-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="HTTPS, Entra ID sign-in (OIDC)&lt;br&gt;Conditional Access: &lt;font color=&quot;#9aa0b4&quot;&gt;staff or admin policy&lt;/font&gt;" vertex="1"><mxGeometry x="74" y="240" width="296" height="34" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#8b5cf6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="60" y="296" width="320" height="78" as="geometry"/></mxCell><mxCell id="a2-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="72" y="306" width="18" height="18" as="geometry"/></mxCell><mxCell id="a2-n" parent="1" style="text;html=1;whiteSpace=wrap;f