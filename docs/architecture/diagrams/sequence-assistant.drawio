OST /mcp (Streamable HTTP), no token" vertex="1"><mxGeometry x="460" y="272" width="270" height="13" as="geometry"/></mxCell><mxCell id="m2" parent="1" style="html=1;strokeColor=#8b5cf6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="289" as="sourcePoint"/><mxPoint x="740" y="289" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="3  401, WWW-Authenticate: Bearer resource_metadata=…/.well-known/oauth-protected-resource" vertex="1"><mxGeometry x="460" y="307" width="270" height="26" as="geometry"/></mxCell><mxCell id="m3" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="337" as="sourcePoint"/><mxPoint x="450" y="337" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="4  GET /.well-known/oauth-protected-resource" vertex="1"><mxGeometry x="460" y="355" width="270" height="13" as="geometry"/></mxCell><mxCell id="m4" parent="1" style="html=1;strokeColor=#8b5cf6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="372" as="sourcePoint"/><mxPoint x="740" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="5  resource, authorization_servers: [Entra tenant]" vertex="1"><mxGeometry x="460" y="390" width="270" height="26" 