icrosoft Entra ID. It applies to people signing in and to the organisation&#x27;s own app-only callers, but not to calls that involve no Entra sign-in. spaceweave still checks every token and every call itself. Each row is one kind of caller, read left to right." vertex="1"><mxGeometry x="30" y="56" width="1940" height="40" as="geometry"/></mxCell><mxCell id="h-Caller" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Caller" vertex="1"><mxGeometry x="40" y="130" width="300" height="20" as="geometry"/></mxCell><mxCell id="h-Entra app registration" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Entra app registration" vertex="1"><mxGeometry x="410" y="130" width="280" height="20" as="geometry"/></mxCell><mxCell id="h-Conditional Access" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Conditional Access" vertex="1"><mxGeometry x="760" y="130" width="360" height="20" as="geometry"/></mxCell><mxCell id="h-What it carries" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="What it carries" vertex="1"><mxGeometry x="1190" y="130" width="280" height="20" as="geometry"/></mxCell><mxCell id="h-spaceweave checks" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="spaceweave checks" vertex="1"><mxGeometry x="1540" y="130" width="360" height="20" as="geometry"/></mxCell><mxCell id="staff-c" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="40" y="230" wi