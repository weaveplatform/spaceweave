<mxfile host="spaceweave-research"><diagram id="seq-calendar" name="Panel → Exchange → spaceweave"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="1239" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f200-g-w" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#94a3b8;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="929" y="200" width="1072" height="240" as="geometry"/></mxCell><mxCell id="f950-api-w" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#2ee6c5;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="1219" y="950" width="782" height="85" as="geometry"/></mxCell><mxCell id="f1049-api-w" parent="1" style="rounded=0;html=1;fillColor=none;strokeColor=#ec4899;strokeWidth=1;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="1219" y="1049" width="782" height="72" as="geometry"/></mxCell><mxCell id="ll-p" parent="1" style="endArrow=none;html=1;dashed=1;dashPattern=3 4;strokeColor=#f5b13d;strokeWidth=1;opacity=70;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="170" as="sourcePoint"/><mxPoint x="160" y="1209" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ll-panel" parent="1" style="endArrow=none;html=1;dashed=1;dashPattern=3 4;strokeColor=#f5b13d;strokeWidth=1;opacity=70;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="170" as="sourcePoint"/><mxPoint x="450" y="1209" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ll-ex" parent="1" style="endArrow=none;html=1;dashed=1;dashPattern=3 4;strokeColor=#3b82f6;strokeWidth=1;opacity=70;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="170" as="sourcePoint"/><mxPoint x="740" y="1209" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ll-g" parent="1" sty