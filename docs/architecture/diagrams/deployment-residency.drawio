" height="22" as="geometry"/></mxCell><mxCell id="z-uks" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#251e1a;strokeColor=#fb923c;strokeWidth=1.2;" value="" vertex="1"><mxGeometry x="40" y="386" width="600" height="274" as="geometry"/></mxCell><mxCell id="z-uks-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#fb923c;align=center;verticalAlign=middle;" value="UK South (London) · 3 availability zones · the deployment target" vertex="1"><mxGeometry x="58" y="375" width="474" height="22" as="geometry"/></mxCell><mxCell id="z-ukw" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#251e1a;strokeColor=#fb923c;strokeWidth=1.2;dashed=1;dashPattern=6 4;" value="" vertex="1"><mxGeometry x="710" y="386" width="310" height="274" as="geometry"/></mxCell><mxCell id="z-ukw-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#fb923c;align=center;verticalAlign=middle;" value="UK West (Cardiff) · DR copies only" vertex="1"><mxGeometry x="728" y="375" width="264" height="22" as="geometry"/></mxCell><mxCell id="z-ew2" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#1b1e2b;strokeColor=#3b82f6;strokeWidth=1.2;" value="" vertex="1"><mxGeometry x="1190" y="386" width="600" height="274" as="geometry"/></mxCell><mxCell id="z-ew2-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#3b82f6;align=center;verticalAlign=middle;" value="europe-west2 (London) · 3 zones · the deployment target, the only UK region" vertex="1"><mxGeometry x="1208" y="375" width="551" height="22" as="geometry"/></mxCell><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Deployment, environments and UK residency" vertex="1"><mxGeometry x="30" y="24" width="2020" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="spaceweave runs for one organisation, in one UK region of the chosen cloud. Each environment has its own subscription or project. On Azure, everything is deployed to UK South; UK West holds only replicated data for disaster recovery. Google Cloud has only one UK region, europe-west2, so in-UK resilience there comes from its three zones." vertex="1"><mxGeometry x="30" y="56" width="2020" height="40" as="geometry"/></mxCell><mxCell id="dev" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="60" y="180" width="300" height="106" as="geometry"/></mxCell><mxCell id="dev-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="72" y="190" width="18" height="18" as="geometry"/></mxCell><mxCell id="dev-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Development" vertex="1"><mxGeometry x="98" y="191" width="250" height="18" as="geometry"/></mxCell><mxCell id="dev-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="214" as="sourcePoint"/><mxPoint x="350" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dev-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="own subscription (Azure) or project (GCP)&lt;br&gt;synthetic data only&lt;br&gt;one zone, small node pools" vertex="1"><mxGeometry x="74" y="220"