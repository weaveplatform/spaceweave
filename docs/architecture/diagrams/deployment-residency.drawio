e="Secret Manager, Artifact Registry" vertex="1"><mxGeometry x="1248" y="549" width="220" height="18" as="geometry"/></mxCell><mxCell id="g-sm-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="572" as="sourcePoint"/><mxPoint x="1470" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g-sm-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="regional, in europe-west2" vertex="1"><mxGeometry x="1224" y="578" width="246" height="48" as="geometry"/></mxCell><mxCell id="g-gcs" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1500" y="538" width="270" height="92" as="geometry"/></mxCell><mxCell id="g-gcs-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1512" y="548" width="18" height="18" as="geometry"/></mxCell><mxCell id="g-gcs-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Cloud Storage" vertex="1"><mxGeometry x="1538" y="549" width="220" height="18" as="geometry"/></mxCell><mxCell id="g-gcs-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1510" y="572" as="sourcePoint"/><mxPoint x="1760" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g-gcs-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="regional bucket in europe-west2" vertex="1"><mxGeometry x="1514" y="578" width="246" height="48" as="geometry"/></mxCell><mxCell id="g-dr" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1840" y="426" width="300" height="204" as="geometry"/></mxCell><mxCell id="g-dr-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1852" y="436" width="18" height="18" as="geometry"/></mxCell><mxCell id="g-dr-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="No second UK region" vertex="1"><mxGeometry x="1878" y="437" width="250" height="18" as="geometry"/></mxCell><mxCell id="g-dr-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="460" as="sourcePoint"/><mxPoint x="2130" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g-dr-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="in the UK, resilience is across zones only&lt;br&gt;losing the whole region means restoring from backups&lt;br&gt;a standby region would be outside the UK, such as europe-west1 (Belgium)&lt;br&gt;that would hold personal data outside the UK: &lt;font color=&quot;#9aa0b4&quot;&gt;a decision for the DPO&lt;/font&gt;" vertex="1"><mxGeometry x="1854" y="466" width="276" height="160" as="geometry"/></mxCell><mxCell id="g-note" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="By default Cloud SQL stores backups in a multi-region location, which can be outside the UK, so the backup location is set to europe-west2." vertex="1"><mxGeometry x="1190" y="680" width="930" height="30" as="geometry"/></mxCell><mxCell id="or" parent="1" style="ellipse;html=1;fillColor=#161823;strokeColor=#e6e8f0;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#e6e8f0;" value="&lt;b&gt;OR&lt;/b&gt;" vertex="1"><mxGeometry x="1083" y="501" width="64" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
