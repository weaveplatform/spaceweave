744" y="466" width="246" height="48" as="geometry"/></mxCell><mxCell id="w-blob" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#fb923c;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="730" y="538" width="270" height="92" as="geometry"/></mxCell><mxCell id="w-blob-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="742" y="548" width="18" height="18" as="geometry"/></mxCell><mxCell id="w-blob-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Blob Storage" vertex="1"><mxGeometry x="768" y="549" width="220" height="18" as="geometry"/></mxCell><mxCell id="w-blob-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="572" as="sourcePoint"/><mxPoint x="990" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w-blob-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="geo-replica in the paired region" vertex="1"><mxGeometry x="744" y="578" width="246" height="48" as="geometry"/></mxCell><mxCell id="e3" parent="1" style="edgeStyle=none;html=1;strokeColor=#fb923c;strokeWidth=1.5;startArrow=oval;startFill=1;startSize=5;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" value="async" edge="1" source="az-pg" target="w-pg"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e4" parent="1" style="edgeStyle=none;html=1;strokeColor=#fb923c;strokeWidth=1.5;startArrow=oval;startFill=1;startSize=5;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#