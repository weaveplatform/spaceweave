mxPoint x="1610" y="170" as="sourcePoint"/><mxPoint x="1610" y="1147" as="targetPoint"/></mxGeometry></mxCell><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Assistant booking through MCP" vertex="1"><mxGeometry x="30" y="24" width="1780" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="An AI assistant (Claude, Microsoft Copilot, ChatGPT) acts for one signed-in person. The MCP server is an OAuth resource server: it accepts only tokens issued for itself, never passes them on, and runs the same rules and role checks as the web app." vertex="1"><mxGeometry x="30" y="56" width="1740" height="40" as="geometry"/></mxCell><mxCell id="m1t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="1  “book me a quiet, height-adjustable desk on Thursday near my team”" vertex="1"><mxGeometry x="170" y="200" width="270" height="26" as="geometry"/></mxCell><mxCell id="m1" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="230" as="sourcePoint"/><mxPoint x="450" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="2  POST /mcp (Streamable HTTP), no token" vertex="1"><mxGeometry x="460" y="272" width="270" height="13" as="geometry"/></mxCell><mxCell id="m2" parent="1" style="html=1;strokeColor=#8b5cf6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometr