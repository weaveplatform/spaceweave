ell><mxCell id="m1t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="1  POST /subscriptions: resource users/{room-oid}/events, changeType created,updated,deleted, notificationUrl, lifecycleNotificationUrl, clientState, expirationDateTime ≤ 10,080 min" vertex="1"><mxGeometry x="1040" y="224" width="850" height="26" as="geometry"/></mxCell><mxCell id="m1" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="254" as="sourcePoint"/><mxPoint x="1030" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="2  POST notificationUrl?validationToken=…" vertex="1"><mxGeometry x="1040" y="272" width="270" height="13" as="geometry"/></mxCell><mxCell id="m2" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="289" as="sourcePoint"/><mxPoint x="1320" y="289" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="3  200 text/plain, the decoded token, within 10 s" vertex="1"><mxGeometry x="1040" y="307" width="270" height="26" as="geometry"/></mxCell><mxCell id="m3" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="337" as="sourcePoint"/><mxPoint x="1030" y="337" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="4  201 Created: subscription id" vertex="1"><mxGeometry x="1040" y="355" width="850" height="13" as="geometry"/></mxCell><mxCell id="m4" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="372" as="sourcePoint"/><mxPoint x="1900" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="394" as="sourcePoint"/><mxPoint x="1900" y="424" as="targetPoint"/><Array as="points"><mxPoint x="1928" y="394"/><mxPoint x="1928" y="424"/></Array></mxGeometry></mxCell><mxCell id="m5t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;verticalAlign=middle;" value="5  PATCH /subscriptions/{id} with a new expirationDateTime before it lapses" vertex="1"><mxGeometry x="1936" y="394" width="250" height="30" as="geometry"/></mxCell><mxCell id="f200-g-w-l" parent="1" style="html=1;fillColor=#161823;strokeColor=#94a3b8;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#e6e8f0;align=left;spacingLeft=6;" value="setup, then renew before expiry" vertex="1"><mxGeometry x="929" y="200" width="210" height="18" as="geometry"/></mxCell><mxCell id="m6t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="6  book this room now, 30 min" vertex="1"><mxGeometry x="170" y="468" width="270" height="13" as="geometry"/></mxCell><mxCell id="m6" parent="1" style="html=1;strokeColor=#f5b13d;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="485" as="sourcePoint"/><mxPoint x="450" y="485" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="7  create the meeting in the room&amp;#x27;s calendar (Webex Hybrid Calendar, or Graph / Crestron Fusion)" vertex="1"><mxGeometry x="460" y="503" width="270" height="39" as="geometry"/></mxCell><mxCell id="m7" parent="1" style="html=1;strokeColor=#f5b13d;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="546" as="sourcePoint"/><mxPoint x="740" y="546" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" parent="1" style="html=1;strokeColor=#3b82f6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="568" as="sourcePoint"/><mxPoint x="740" y="598" as="targetPoint"/><Array as="points"><mxPoint x="768" y="568"/><mxPoint x="768" y="598"/></Array></mxGeometry></mxCell><mxCell id="m8t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;verticalAlign=middle;" value="8  AutomateProcessing AutoAccept: free = accept, busy = decline" vertex="1"><mxGeometry x="776" y="568" width="240" height="30" as="geometry"/></mxCell><mxCell id="m9t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="9  POST notification: value[] { subscriptionId, clientState, changeType, resource }" vertex="1"><mxGeometry x="1040" y="614" width="270" height="26" as="geometry"/></mxCell><mxCell id="m9" parent="1" style="html=1;strokeColor=#3b82f6;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="644" as="sourcePoint"/><mxPoint x="1320" y="644" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="666" as="sourcePoint"/><mxPoint x="1320" y="696" as="targetPoint"/><Array as="points"><mxPoint x="1348" y="666"/><mxPoint x="1348" y="696"/></Array></mxGeometry></mxCell><mxCell id="m10t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;verticalAlign=middle;" value="10  check clientState matches; enqueue a sync job for the room" vertex="1"><mxGeometry x="1356" y="666" width="230" height="30" as="geometry"/></mxCell><mxCell id="m11t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="11  INSERT job" vertex="1"><mxGeometry x="1330" y="712" width="270" height="13" as="geometry"/></mxCell><mxCell id="m11" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="729" as="sourcePoint"/><mxPoint x="1610" y="729" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="12  202 Accepted within 3 s (slow endpoints are throttled, then notifications dropped)" vertex="1"><mxGeometry x="1040" y="747" width="270" height="26" as="geometry"/></mxCell><mxCell id="m12" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="777" as="sourcePoint"/><mxPoint x="1030" y="777" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="13  claim the job (FOR UPDATE SKIP LOCKED)" vertex="1"><mxGeometry x="1620" y="795" width="270" height="13" as="geometry"/></mxCell><mxCell id="m13" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="812" as="sourcePoint"/><mxPoint x="1610" y="812" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="14  GET deltaLink: /users/{room-oid}/calendarView/delta" vertex="1"><mxGeometry x="1040" y="830" width="850" height="13" as="geometry"/></mxCell><mxCell id="m14" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="847" as="sourcePoint"/><mxPoint x="1030" y="847" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="15  changed events, @removed for deleted ones, new @odata.deltaLink" vertex="1"><mxGeometry x="1040" y="865" width="850" height="13" as="geometry"/></mxCell><mxCell id="m15" parent="1" style="html=1;strokeColor=#3b82f6;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="882" as="sourcePoint"/><mxPoint x="1900" y="882" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" parent="1" style="html=1;strokeColor=#f87171;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="904" as="sourcePoint"/><mxPoint x="1900" y="934" as="targetPoint"/><Array as="points"><mxPoint x="1928" y="904"/><mxPoint x="1928" y="934"/></Array></mxGeometry></mxCell><mxCell id="m16t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;verticalAlign=middle;" value="16  match on iCalUId; apply spaceweave rules: hours, closures, approvals" vertex="1"><mxGeometry x="1936" y="904" width="230" height="30" as="geometry"/></mxCell><mxCell id="m17t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="17  BookingOccurrence allocated, source: calendar; DomainEvent and outbox row in one transaction" vertex="1"><mxGeometry x="1620" y="974" width="270" height="39" as="geometry"/></mxCell><mxCell id="m17" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="1017" as="sourcePoint"/><mxPoint x="1610" y="1017" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f950-api-w-l" parent="1" style="html=1;fillColor=#161823;strokeColor=#2ee6c5;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#e6e8f0;align=left;spacingLeft=6;" value="alt  rules pass" vertex="1"><mxGeometry x="1219" y="950" width="111" height="18" as="geometry"/></mxCell><mxCell id="m18t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="18  keep the booking, flag a conflict for a workplace admin, notify the organiser" vertex="1"><mxGeometry x="1620" y="1073" width="270" height="26" as="geometry"/></mxCell><mxCell id="m18" parent="1" style="html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="1103" as="sourcePoint"/><mxPoint x="1610" y="1103" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f1049-api-w-l" parent="1" style="html=1;fillColor=#161823;strokeColor=#ec4899;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#e6e8f0;align=left;spacingLeft=6;" value="alt  rule breached (closure, outside hours, needs approval)" vertex="1"><mxGeometry x="1219" y="1049" width="383" height="18" as="geometry"/></mxCell><mxCell id="n1141" parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#f5b13d;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="Lifecycle notifications to lifecycleNotificationUrl: reauthorizationRequired → POST /subscriptions/{id}/reauthorize; subscriptionRemoved → create a new subscription and resync with delta; missed → full resync with delta. Bookings made in spaceweave flow the other way: the worker writes the event to the room mailbox and the panel shows it." vertex="1"><mxGeometry x="645" y="1141" width="1350" height="40" as="geometry"/></mxCell><mxCell id="p-p" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;" value="&lt;b&gt;Person at the panel&lt;/b&gt;" vertex="1"><mxGeometry x="65" y="120" width="190" height="50" as="geometry"/></mxCell><mxCell id="p-panel" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;" value="&lt;b&gt;Room panel (Cisco / Crestron)&lt;/b&gt;" v