gn=center;verticalAlign=bottom;" value="8  200 OK" vertex="1"><mxGeometry x="750" y="589" width="560" height="13" as="geometry"/></mxCell><mxCell id="m8" parent="1" style="html=1;strokeColor=#ec4899;strokeWidth=1.4;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="606" as="sourcePoint"/><mxPoint x="740" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="9  mark delivered" vertex="1"><mxGeometry x="460" y="624" width="270" height="13" as="geometry"/></mxCell><mxCell id="m9" parent="1" style="html=1;strokeColor=#2ee6c5;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="641" as="sourcePoint"/><mxPoint x="450" y="641" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f565-d-sub-l" parent="1" style="html=1;fillColor=#161823;strokeColor=#2ee6c5;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#e6e8f0;align=left;spacingLeft=6;" value="alt  2xx" vertex="1"><mxGeometry x="639" y="565" width="67" height="18" as="geometry"/></mxCell><mxCell id="m10t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;align=center;verticalAlign=bottom;" value="10  schedule a retry with the same msg_id: backoff with jitter, e.g. 5 s, 5 m, 30 m, 2 h, 5 h, 10 h, 14 h, 20 h, 24 h" vertex="1"><mxGeometry x="460" y="697" width="270" height="39" as="geometry"/></mxCell><mxCell id="m10" parent="1" style="html=1;strokeColor=#f5b13d;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="740" as="sourcePoint"/><mxPoint x="450" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="