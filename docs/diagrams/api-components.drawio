        <mxCell id="contract-note-heading" value="API classification and purpose" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=none;spacing=0;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="contract-note">
          <mxGeometry x="34.2" y="-24.7" width="703.0" height="49.4" as="geometry" />
        </mxCell>
        <mxCell id="contract-note-body" value="Upper label: public / private / provider API and kind.&lt;br&gt;Lower label: purpose and function. Access is always scoped." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=21;fontColor=#323130;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="contract-note">
          <mxGeometry x="34.2" y="68.4" width="2296.0699999999997" height="121.6" as="geometry" />
        </mxCell>
        <mxCell id="ownership-note" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#B3B3B3;dashed=0;container=1;pointerEvents=0;fontFamily=Segoe UI,Arial,sans-serif;fontColor=#323130;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="2470.87" y="4347.2" width="2364.4700000000003" height="209.0" as="geometry" />
        </mxCell>
        <mxCell id="ownership-note-heading" value="Ownership and consistency" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=none;spacing=0;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="ownership-note">
          <mxGeometry x="34.2" y="-24.7" width="703.0" height="49.4" as="geometry" />
        </mxCell>
        <mxCell id="ownership-note-body" value="The capability box groups owning components, not one service.&lt;br&gt;Workers call the same owners; no private worker HTTP is required." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=21;fontColor=#323130;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="ownership-note">
          <mxGeometry x="34.2" y="68.4" width="2296.0699999999997" height="121.6" as="geometry" />
        </mxCell>
        <mxCell id="state-note" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#B3B3B3;dashed=0;container=1;pointerEvents=0;fontFamily=Segoe UI,Arial,sans-serif;fontColor=#323130;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="4880.93" y="4347.2" width="2273.27" height="209.0" as="geometry" />
        </mxCell>
        <mxCell id="state-note-heading" value="Acceptance and external completion" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#000000;fillColor=#FFFFFF;strokeColor=none;spacing=0;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="state-note">
          <mxGeometry x="34.2" y="-24.7" width="703.0" height="49.4" as="geometry" />
        </mxCell>
        <mxCell id="state-note-body" value="Desk taken only after its owner checks in; room confirmed after Exchange acceptance.&lt;br&gt;Jobs and outbound calls cannot bypass the owning capacity authority." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=21;fontColor=#323130;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="state-note">
          <mxGeometry x="34.2" y="68.4" width="2204.87" height="121.6" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Flow legend&lt;/b&gt; &amp;nbsp; &lt;font color=&quot;#0078D4&quot;&gt;━ HTTP / provider APIs&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#7030A0&quot;&gt;━ Identity / provisioning&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#323130&quot;&gt;━ Owning Go calls&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#198AB3&quot;&gt;━ Asset transfer&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#BF9000&quot;&gt;┄ Durable work (dashed)&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#666666&quot;&gt;━ Health / telemetry&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=21;fontColor=#000000;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60.8" y="4617.0" width="7154.2" height="45.6" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Sources: API surface catalogue, REST request contract and architecture blueprint. Components are proposals; API names describe their capabilities and do not imply independent deployments." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI,Arial,sans-serif;fontSize=20;fontColor=#323130;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60.8" y="4693.0" width="7154.2" height="57.0" as="geometry" />
