        <mxCell id="ownership-note" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#1b1e2b;strokeColor=#f5b13d;dashed=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="984.67" y="2288.0" width="928.67" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ownership-note-heading" value="Ownership and consistency" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;spacing=3;align=center;verticalAlign=middle;" vertex="1" parent="ownership-note">
          <mxGeometry x="18" y="-13" width="370" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ownership-note-body" value="The capability box groups owning components, not one service.&lt;br&gt;Workers call the same owners; no private worker HTTP is required." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#c8ccda;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="ownership-note">
          <mxGeometry x="18" y="36" width="892.67" height="64" as="geometry" />
        </mxCell>
        <mxCell id="state-note" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#1b1e2b;strokeColor=#f5b13d;dashed=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1937.33" y="2288.0" width="880.67" height="110" as="geometry" />
        </mxCell>
        <mxCell id="state-note-heading" value="Acceptance and external completion" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;spacing=3;align=center;verticalAlign=middle;" vertex="1" parent="state-note">
          <mxGeometry x="18" y="-13" width="370" height="26" as="geometry" />
        </mxCell>
        <mxCell id="state-note-body" value="Desk taken only after its owner checks in; room confirmed after Exchange acceptance.&lt;br&gt;Jobs and outbound calls cannot bypass the owning capacity authority." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#c8ccda;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="state-note">
          <mxGeometry x="18" y="36" width="844.67" height="64" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Purple: application components    ·    Grey: clients / platform callers    ·    Blue: external providers / stores    ·    Teal arrow: request, dependency or call    ·    Amber dashed arrow: durable job / fact delivery" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="32" y="2430.0" width="2818.0" height="24" as="geometry" />
