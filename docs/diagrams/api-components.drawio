        <mxCell id="contract-note" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#B3B3B3;dashed=0;container=1;pointerEvents=0;fontFamily=Segoe UI,Arial,sans-serif;fontColor=#323130;strokeWidth=1;" vertex="1" parent="1">
