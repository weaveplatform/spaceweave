        <mxCell id="contract-note-heading" value="API classification and purpose" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;spacing=3;align=center;verticalAlign=middle;" vertex="1" parent="contract-note">
          <mxGeometry x="18" y="-13" width="370" height="26" as="geometry" />
        </mxCell>
        <mxCell id="contract-note-body" value="Upper label: public / private / provider API and kind.&lt;br&gt;Lower label: purpose and function. Access is always scoped." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#c8ccda;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="contract-note">
          <mxGeometry x="18" y="36" width="892.67" height="64" as="geometry" />
