        <mxCell id="authority-note-heading" value="Authority &amp; business-state boundaries" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="838" y="2067" width="338" height="26" as="geometry" />
        </mxCell>
        <mxCell id="authority-note-body" value="MCP retains the user's authority; machine scripts use independent application grants.&lt;br&gt;Actual actor, requesting client and staff booking owner remain separate.&lt;br&gt;Desk allocated → taken only after the owner's personal check-in.&lt;br&gt;Room pending → confirmed only after Exchange accepts." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#c8ccda;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="830" y="2102" width="718" height="92" as="geometry" />
