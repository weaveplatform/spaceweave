        <mxCell id="request-note-heading" value="Common REST contract" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="62" y="2067" width="242" height="26" as="geometry" />
        </mxCell>
        <mxCell id="request-note-body" value="Retry keys + atomic receipts for booking, ticket and work acceptance.&lt;br&gt;Previously read versions for shared configuration edits.&lt;br&gt;standard / expensive budgets: one token per admitted attempt, including replays.&lt;br&gt;Deferred work has public operation status; acceptance is not confirmation." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#c8ccda;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="52" y="2102" width="706" height="92" as="geometry" />
