 style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Common workspace-booking domain model" vertex="1"><mxGeometry x="30" y="24" width="3701" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="Eight pillars, booking first. Floor plans matter for three things only: turning a drawing into a bookable inventory, keeping identity across revised drawings (RevisionMapping), and drawing a recognisable map, so walls, doors and windows are render layers of a revision, not domain entities. Allocation is a versioned event per cycle; Rules govern allocation, booking and check-in. References to Person, Group and Role are written in the cards (→). Each relation is coloured by the pillar it starts from. Grey dashed = spaceweave-owned, not offered by any surveyed vendor." vertex="1"><mxGeometry x="30" y="54" width="3701" height="48" as="geometry"/></mxCell><mxCell id="lg0" parent="1" style="rounded=1;arcSize=20;fillColor=#1d2030;strokeColor=#3b82f6;" value="" vertex="1"><mxGeometry x="30" y="1819" width="16" height="14" as="geometry"/></mxCell><mxCell id="lg0t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="Places &amp; floor plans" vertex="1"><mxGeometry x="56" y="1819" width="144" height="16" as="geometry"/></mxCell><mxCell id="lg1" parent="1" style="rounded=1;arcSize=20;fillColor=#1d2030;strokeColor=#8b5cf6;" value="" vertex="1"><mxGeometry x="212" y="1819" width="16" height="14" as="geometry"/></mxCell><mxCell id="lg1t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="Bookable" vertex="1"><mxGeometry x="238" y="1819" width="60" height="16" as="geometry