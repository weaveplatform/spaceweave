<mxfile host="spaceweave-research"><diagram id="space-allocation-lifecycle" name="Space allocation"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3060" pageHeight="980" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z-steps" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#1a2228;strokeColor=#2ee6c5;strokeWidth=1.2;" value="" vertex="1"><mxGeometry x="20" y="430" width="3000" height="246" as="geometry"/></mxCell><mxCell id="z-steps-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#2ee6c5;align=center;verticalAlign=middle;" value="Weekly cycle, per venue" vertex="1"><mxGeometry x="38" y="419" width="187" height="22" as="geometry"/></mxCell><mxCell id="z-config" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#241f1b;strokeColor=#f5b13d;strokeWidth=1.2;" value="" vertex="1"><mxGeometry x="20" y="150" width="1820" height="190" as="geometry"/></mxCell><mxCell id="z-config-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;align=center;verticalAlign=middle;" value="Configurable business rules · versioned, effective-dated" vertex="1"><mxGeometry x="38" y="139" width="418" height="22" as="geometry"/></mxCell><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Space allocation lifecycle (desks first)" vertex="1"><mxGeometry x="30" y="24" width="2900" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A generic engine, run for the kinds a venue sets to allocated (desks first); hot desks, rooms and everything else stay self-service, sharing the same waitlist. People ask for a kind of space, never a specific one, like booking a hotel room. A weekly run groups the requests and packs the groups onto floors; daily top-up runs place late requests. Every business rule the run applies is configuration: versioned, effective-dated and changed without code, so the plan always records which version produced it." vertex="1"><mxGeometry x="30" y="56" width="2900" height="36" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="40" y="470" width="240" height="176" as="geometry"/></mxCell><mxCell id="s1-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="52" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s1-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="1 · Request" vertex="1"><mxGeometry x="78" y="481" width="190" height="18" as="geometry"/></mxCell><mxCell id="s1-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="504" as="sourcePoint"/><mxPoint x="270" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="a kind of space, never a specific one&lt;br&gt;must-have and nice-to-have labels&lt;br&gt;dates, part of day, venue&lt;br&gt;optional: &lt;font color=&quot;#9aa0b4&quot;&gt;sit near my collaborators or named people&lt;/font&gt;&lt;br&gt;also need parking, locker, bike rack: &lt;font color=&quot;#9aa0b4&quot;&gt;required (I only come if I get it) or optional&lt;/font&gt;&lt;br&gt;timestamped: &lt;font color=&quot;#9aa0b4&quot;&gt;first come, first served&lt;/font&gt;" vertex="1"><mxGeometry x="54" y="510" width="216" height="132" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="420" y="470" width="220" height="176" as="geometry"/></mxCell><mxCell id="s2-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="432" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s2-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="2 · Cut-off" vertex="1"><mxGeometry x="458" y="481" width="170" height="18" as="geometry"/></mxCell><mxCell id="s2-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="504" as="sourcePoint"/><mxPoint x="630" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="the weekly cycle closes intake for next week&lt;br&gt;late requests wait for a top-up run" vertex="1"><mxGeometry x="434" y="510" width="196" height="132" as="geometry"/></mxCell><mxCell id="s3" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="780" y="470" width="240" height="176" as="geometry"/></mxCell><mxCell id="s3-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="792" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s3-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="3 · Group" vertex="1"><mxGeometry x="818" y="481" width="190" height="18" as="geometry"/></mxCell><mxCell id="s3-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="504" as="sourcePoint"/><mxPoint x="1010" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="requests clustered per date into SeatingGroups&lt;br&gt;by org team, delivery team, declared collaborators, and inferred collaboration (opt-in)&lt;br&gt;large groups split into sub-groups kept near each other" vertex="1"><mxGeometry x="794" y="510" width="216" height="132" as="geometry"/></mxCell><mxCell id="s4" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1160" y="470" width="660" height="176" as="geometry"/></mxCell><mxCell id="s4-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1172" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s4-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="4 · Pack" vertex="1"><mxGeometry x="1198" y="481" width="610" height="18" as="geometry"/></mxCell><mxCell id="s4-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="504" as="sourcePoint"/><mxPoint x="1810" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="first: &lt;font color=&quot;#9aa0b4&quot;&gt;fixed assignments and ring-fenced seats come out of supply&lt;/font&gt;&lt;br&gt;hard: &lt;font color=&quot;#9aa0b4&quot;&gt;capacity, must-have labels, keep-apart constraints, rules, closures; required companions secured, or the request is not placed&lt;/font&gt;&lt;br&gt;soft: &lt;font color=&quot;#9aa0b4&quot;&gt;groups together (zone, then floor), nice-to-have labels, same desk as last time, fairness, fewer floors open&lt;/font&gt;&lt;br&gt;shortfall: &lt;font color=&quot;#9aa0b4&quot;&gt;first come, first served; the rest join the one waitlist&lt;/font&gt;" vertex="1"><mxGeometry x="1174" y="510" width="636" height="132" as="geometry"/></mxCell><mxCell id="s5" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1960" y="470" width="240" height="176" as="geometry"/></mxCell><mxCell id="s5-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1972" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s5-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="5 · Review &amp;amp; publish" vertex="1"><mxGeometry x="1998" y="481" width="190" height="18" as="geometry"/></mxCell><mxCell id="s5-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="504" as="sourcePoint"/><mxPoint x="2190" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="draft plan with score and unmet preferences&lt;br&gt;an admin reviews and publishes&lt;br&gt;each Placement becomes an allocated booking, linked to its companions&lt;br&gt;people are told where, and why&lt;br&gt;frozen unless the person cancels" vertex="1"><mxGeometry x="1974" y="510" width="216" height="132" as="geometry"/></mxCell><mxCell id="s6" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="2340" y="470" width="260" height="176" as="geometry"/></mxCell><mxCell id="s6-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="2352" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s6-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="6 · The week" vertex="1"><mxGeometry x="2378" y="481" width="210" height="18" as="geometry"/></mxCell><mxCell id="s6-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2350" y="504" as="sourcePoint"/><mxPoint x="2590" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s6-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="daily top-up runs place late requests and the waitlist into freed space&lt;br&gt;cancellations free space; a required companion cancels with it&lt;br&gt;check-in: &lt;font color=&quot;#9aa0b4&quot;&gt;allocated → taken; no-show → released&lt;/font&gt;" vertex="1"><mxGeometry x="2354" y="510" width="236" height="132" as="geometry"/></mxCell><mxCell id="s7" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="2740" y="470" width="240" height="176" as="geometry"/></mxCell><mxCell id="s7-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="2752" y="480" width="18" height="18" as="geometry"/></mxCell><mxCell id="s7-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="7 · Learn" vertex="1"><mxGeometry x="2778" y="481" width="190" height="18" as="geometry"/></mxCell><mxCell id="s7-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2750" y="504" as="sourcePoint"/><mxPoint x="2970" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s7-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="Utilisation: &lt;font color=&quot;#9aa0b4&quot;&gt;booked vs occupied vs no-show&lt;/font&gt;&lt;br&gt;feeds the next cycle&amp;#x27;s policy" vertex="1"><mxGeometry x="2754" y="510" width="216" height="132" as="geometry"/></mxCell><mxCell id="rules" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="40" y="190" width="240" height="120" as="geometry"/></mxCell><mxCell id="rules-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="52" y="200" width="18" height="18" as="geometry"/></mxCell><mxCell id="rules-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Rules &amp;amp; entitlements" vertex="1"><mxGeometry x="78" y="201" width="190" height="18" as="geometry"/></mxCell><mxCell id="rules-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="224" as="sourcePoint"/><mxPoint x="270" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="who may request, how many days&lt;br&gt;booking horizon, priority" vertex="1"><mxGeometry x="54" y="230" width="216" height="76" as="geometry"/></mxCell><mxCell id="policy" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="780" y="190" width="500" height="120" as="geometry"/></mxCell><mxCell id="policy-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="792" y="200" width="18" height="18" as="geometry"/></mxCell><mxCell id="policy-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="AllocationPolicy" vertex="1"><mxGeometry x="818" y="201" width="450" height="18" as="geometry"/></mxCell><mxCell id="policy-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="224" as="sourcePoint"/><mxPoint x="1270" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="policy-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="grouping: &lt;font color=&quot;#9aa0b4&quot;&gt;org team | delivery team | declared | inferred (opt-in)&lt;/font&gt;&lt;br&gt;precedence: &lt;font color=&quot;#9aa0b4&quot;&gt;e.g. delivery team over org team while it runs&lt;/font&gt;&lt;br&gt;weights: &lt;font color=&quot;#9aa0b4&quot;&gt;proximity, floor consolidation, stability, fairness&lt;/font&gt;&lt;br&gt;ties and shortfall: &lt;font color=&quot;#9aa0b4&quot;&gt;first come, first served&lt;/font&gt;&lt;br&gt;overbooking factor" vertex="1"><mxGeometry x="794" y="230" width="476" height="76" as="geometry"/></mxCell><mxCell id="proxc" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1380" y="190" width="210" height="120" as="geometry"/></mxCell><mxCell id="proxc-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1392" y="200" width="18" height="18" as="geometry"/></mxCell><mxCell id="proxc-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="ProximityConstraint" vertex="1"><mxGeometry x="1418" y="201" width="160" height="18" as="geometry"/></mxCell><mxCell id="proxc-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="224" as="sourcePoint"/><mxPoint x="1580" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="proxc-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="keep_apart | keep_near&lt;br&gt;hard or soft&lt;br&gt;e.g. trader desks behind an information barrier" vertex="1"><mxGeometry x="1394" y="230" width="186" height="76" as="geometry"/></mxCell><mxCell id="team" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#f5b13d;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1610" y="190" width="210" height="120" as="geometry"/></mxCell><mxCell id="team-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1622" y="200" width="18" height="18" as="geometry"/></mxCell><mxCell id="team-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="CollaboratorAllocation" vertex="1"><mxG