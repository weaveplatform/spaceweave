<mxfile host="spaceweave-research"><diagram id="floor-plan-pipeline" name="Floor plans"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2840" pageHeight="866" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z-steps" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#1b1e2b;strokeColor=#3b82f6;strokeWidth=1.2;" value="" vertex="1"><mxGeometry x="20" y="400" width="2820" height="218" as="geometry"/></mxCell><mxCell id="z-steps-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#3b82f6;align=center;verticalAlign=middle;" value="Per drawing, per level" vertex="1"><mxGeometry x="38" y="389" width="180" height="22" as="geometry"/></mxCell><mxCell id="z-cfg" parent="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;fillColor=#241f1b;strokeColor=#f5b13d;strokeWidth=1.2;" value="" vertex="1"><mxGeometry x="660" y="130" width="1450" height="204" as="geometry"/></mxCell><mxCell id="z-cfg-l" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;fillColor=#161823;strokeColor=#f5b13d;align=center;verticalAlign=middle;" value="Configuration · versioned" vertex="1"><mxGeometry x="678" y="119" width="201" height="22" as="geometry"/></mxCell><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="Floor-plan import and revision pipeline" vertex="1"><mxGeometry x="30" y="24" width="2840" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A drawing becomes a published floor plan in eight steps. Bookings depend on the stable key of each desk, room and bay, not on the drawing, so every change to that inventory is matched, reviewed and published before it takes effect. Geometry only has to look right; the bookable inventory has to be right." vertex="1"><mxGeometry x="30" y="56" width="2840" height="40" as="geometry"/></mxCell><mxCell id="f1" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="40" y="440" width="250" height="148" as="geometry"/></mxCell><mxCell id="f1-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="52" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f1-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="1 · Source" vertex="1"><mxGeometry x="78" y="451" width="200" height="18" as="geometry"/></mxCell><mxCell id="f1-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="474" as="sourcePoint"/><mxPoint x="280" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f1-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="web UI: &lt;font color=&quot;#9aa0b4&quot;&gt;upload from the local file system&lt;/font&gt;&lt;br&gt;CLI: &lt;font color=&quot;#9aa0b4&quot;&gt;spaceweave upload&lt;/font&gt;&lt;br&gt;REST API: &lt;font color=&quot;#9aa0b4&quot;&gt;an import endpoint for scripts&lt;/font&gt;&lt;br&gt;formats: &lt;font color=&quot;#9aa0b4&quot;&gt;DWG, DXF, PDF, SVG, or an image&lt;/font&gt;" vertex="1"><mxGeometry x="54" y="480" width="226" height="104" as="geometry"/></mxCell><mxCell id="f2" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="360" y="440" width="250" height="148" as="geometry"/></mxCell><mxCell id="f2-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="372" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f2-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="2 · Ingest" vertex="1"><mxGeometry x="398" y="451" width="200" height="18" as="geometry"/></mxCell><mxCell id="f2-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="474" as="sourcePoint"/><mxPoint x="600" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f2-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="format checked by extension and first bytes; refused with a reason&lt;br&gt;original kept unchanged&lt;br&gt;checksum: &lt;font color=&quot;#9aa0b4&quot;&gt;a file is never processed twice&lt;/font&gt;&lt;br&gt;opens a draft FloorPlanRevision" vertex="1"><mxGeometry x="374" y="480" width="226" height="104" as="geometry"/></mxCell><mxCell id="f3" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="680" y="440" width="290" height="148" as="geometry"/></mxCell><mxCell id="f3-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="692" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f3-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="3 · Extract" vertex="1"><mxGeometry x="718" y="451" width="240" height="18" as="geometry"/></mxCell><mxCell id="f3-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="474" as="sourcePoint"/><mxPoint x="960" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f3-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="drawing converted for tracing; scale from its declared units&lt;br&gt;layer roles from the import profile&lt;br&gt;walls, doors, windows, spaces, desks and their names" vertex="1"><mxGeometry x="694" y="480" width="266" height="104" as="geometry"/></mxCell><mxCell id="f4" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1040" y="440" width="290" height="148" as="geometry"/></mxCell><mxCell id="f4-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1052" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f4-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="4 · Render" vertex="1"><mxGeometry x="1078" y="451" width="240" height="18" as="geometry"/></mxCell><mxCell id="f4-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="474" as="sourcePoint"/><mxPoint x="1320" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f4-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="one 3D model of the floor: &lt;font color=&quot;#9aa0b4&quot;&gt;walls and furniture as solids&lt;/font&gt;&lt;br&gt;spaces filled by use and floor finish&lt;br&gt;plan, bird&amp;#x27;s-eye and isometric are the same model, projected" vertex="1"><mxGeometry x="1054" y="480" width="266" height="104" as="geometry"/></mxCell><mxCell id="f5" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1400" y="440" width="300" height="148" as="geometry"/></mxCell><mxCell id="f5-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1412" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f5-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="5 · Match" vertex="1"><mxGeometry x="1438" y="451" width="250" height="18" as="geometry"/></mxCell><mxCell id="f5-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1410" y="474" as="sourcePoint"/><mxPoint x="1690" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f5-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="compare with the published revision&lt;br&gt;RevisionMapping per key: &lt;font color=&quot;#9aa0b4&quot;&gt;unchanged, moved, renamed, split, merged, removed or added, with a confidence&lt;/font&gt;" vertex="1"><mxGeometry x="1414" y="480" width="276" height="104" as="geometry"/></mxCell><mxCell id="f6" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1770" y="440" width="320" height="148" as="geometry"/></mxCell><mxCell id="f6-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1782" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f6-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="6 · Review" vertex="1"><mxGeometry x="1808" y="451" width="270" height="18" as="geometry"/></mxCell><mxCell id="f6-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1780" y="474" as="sourcePoint"/><mxPoint x="2080" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f6-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="trace overlay against the source drawing&lt;br&gt;splits, merges, removals and low confidence become review items&lt;br&gt;correct a layer role, then retrace&lt;br&gt;target: &lt;font color=&quot;#9aa0b4&quot;&gt;99% or better on desks, names, ids and membership&lt;/font&gt;" vertex="1"><mxGeometry x="1784" y="480" width="296" height="104" as="geometry"/></mxCell><mxCell id="f7" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="2160" y="440" width="250" height="148" as="geometry"/></mxCell><mxCell id="f7-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="2172" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f7-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="7 · Publish" vertex="1"><mxGeometry x="2198" y="451" width="200" height="18" as="geometry"/></mxCell><mxCell id="f7-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2170" y="474" as="sourcePoint"/><mxPoint x="2400" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f7-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="published with an effective date&lt;br&gt;the old revision is superseded and kept" vertex="1"><mxGeometry x="2174" y="480" width="226" height="104" as="geometry"/></mxCell><mxCell id="f8" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#3b82f6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="2480" y="440" width="320" height="148" as="geometry"/></mxCell><mxCell id="f8-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="2492" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="f8-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="8 · Carry over" vertex="1"><mxGeometry x="2518" y="451" width="270" height="18" as="geometry"/></mxCell><mxCell id="f8-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2490" y="474" as="sourcePoint"/><mxPoint x="2790" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f8-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="assignments, labels, QR codes, connector mappings and future bookings follow their keys&lt;br&gt;a removed or split desk: &lt;font color=&quot;#9aa0b4&quot;&gt;its bookings are flagged and people offered another desk or the waitlist&lt;/font&gt;&lt;br&gt;DomainEvent: &lt;font color=&quot;#9aa0b4&quot;&gt;floor plan published&lt;/font&gt;" vertex="1"><mxGeometry x="2494" y="480" width="296" height="104" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="edgeStyle=none;html=1;strokeColor=#3b82f6;strokeWidth=1.5;startArrow=oval;startFill=1;startSi