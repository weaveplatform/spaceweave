yle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="released early" edge="1" source="taken" target="released"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="foot" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A released or no-show resource goes back to supply: the waitlist is offered it, or the next top-up run places someone in it. Releasing an assigned desk for a day is an AssignmentRelease, not a booking state." vertex="1"><mxGeometry x="30" y="700" width="1600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
