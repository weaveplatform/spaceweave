<mxfile host="spaceweave-research"><diagram id="sm-booking-occurrence" name="BookingOccurrence"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1680" pageHeight="740" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="BookingOccurrence lifecycle" vertex="1"><mxGeometry x="30" y="24" width="1500" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A booking occurrence is one booking of one resource for one time slot. It can come from self-service (the web app, an assistant or the API), from an allocation run, or from a booking made in Exchange or on a room panel. Once it is allocated, the resource is yours, and once you check in, it is taken. States with a bold border are end states." vertex="1"><mxGeometry x="30" y="56" width="1500" height="36" as="geometry"/></mxCell><mxCell id="s0" parent="1" style="ellipse;html=1;fillColor=#ec4899;strokeColor=#ec4899;" value="" vertex="1"><mxGeometry x="30" y="302" width="16" height="16" as="geometry"/></mxCell><mxCell id="held" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;held&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;rules evaluated&lt;/font&gt;" vertex="1"><mxGeometry x="130" y="290" width="170" height="58" as="geometry"/></mxCell><mxCell id="pending" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;pending&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;approval_required&lt;/font&gt;" vertex="1"><mxGeometry x="430" y="120" width="170" height="58" as="geometry"/></mxCell><mxCell id="alloc" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;allocated&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;the resource is yours&lt;/font&gt;" vertex="1"><mxGeometry x="740" y="290" width="170" height="58" as="geometry"/></mxCell><mxCell id="taken" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;checked_in (taken)&lt;/b&gt;" vertex="1"><mxGeometry x="1130" y="290" width="170" height="40" as="geometry"/></mxCell><mxCell id="done" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=3;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;completed&lt;/b&gt;" vertex="1"><mxGeometry x="1470" y="290" width="170" height="40" as="geometry"/></mxCell><mxCell id="cancel" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=3;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;cancelled&lt;/b&gt;" vertex="1"><mxGeometry x="430" y="490" width="170" height="40" as="geometry"/></mxCell><mxCell id="noshow" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=3;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;no_show&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;resource back to supply&lt;/font&gt;" vertex="1"><mxGeometry x="1130" y="610" width="170" height="58" as="geometry"/></mxCell><mxCell id="released" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#ec4899;strokeWidth=3;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;released&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;resource back to supply&lt;/font&gt;" vertex="1"><mxGeometry x="1470" y="490" width="170" height="58" as="geometry"/></mxCell><mxCell id="s1" parent="1" style="ellipse;html=1;fillColor=#2ee6c5;strokeColor=#2ee6c5;" value="" vertex="1"><mxGeometry x="757" y="200" width="16" height="16" as="geometry"/></mxCell><mxCell id="s1t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="allocation run publishes a Placement" vertex="1"><mxGeometry x="560" y="198" width="190" height="16" as="geometry"/></mxCell><mxCell id="s2" parent="1" style="ellipse;html=1;fillColor=#3b82f6;strokeColor=#3b82f6;" value="" vertex="1"><mxGeometry x="876" y="200" width="16" height="16" as="geometry"/></mxCell><mxCell id="s2t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="calendar booking reconciled (Exchange, room panel)" vertex="1"><mxGeometry x="900" y="198" width="300" height="16" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;labelBackgroundColor=#161823;" value="" edge="1" source="s0" targe