<mxfile host="spaceweave-research"><diagram id="sm-space-request" name="SpaceRequest"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1150" pageHeight="530" background="#161823" math="0" shadow="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="SpaceRequest lifecycle" vertex="1"><mxGeometry x="30" y="24" width="1500" height="24" as="geometry"/></mxCell><mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#9aa0b4;align=left;verticalAlign=top;spacing=0;" value="A space request asks for a kind of space, such as a height-adjustable desk, never a specific one. Requests the run cannot place join the single waitlist in the order they were made. If the person needs parking, a locker or a bike rack to come in at all, the request is placed only once that is secured too." vertex="1"><mxGeometry x="30" y="56" width="1500" height="36" as="geometry"/></mxCell><mxCell id="s0" parent="1" style="ellipse;html=1;fillColor=#2ee6c5;strokeColor=#2ee6c5;" value="" vertex="1"><mxGeometry x="30" y="162" width="16" height="16" as="geometry"/></mxCell><mxCell id="s0t" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="requested" vertex="1"><mxGeometry x="22" y="136" width="80" height="14" as="geometry"/></mxCell><mxCell id="open" parent="1" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#e6e8f0;align=center;verticalAlign=middle;" value="&lt;b&gt;open&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0b4&quot; style=&quot;font-size:9px&quot;&gt;requested_at stamps