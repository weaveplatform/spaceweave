 height="18" as="geometry"/></mxCell><mxCell id="c2-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="2 · Quality gate" vertex="1"><mxGeometry x="378" y="411" width="250" height="18" as="geometry"/></mxCell><mxCell id="c2-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="434" as="sourcePoint"/><mxPoint x="630" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c2-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="golangci-lint, blocking&lt;br&gt;unit tests on ubuntu, macos and windows -latest&lt;br&gt;acceptance tests against real PostgreSQL (testcontainers)&lt;br&gt;coverage: &lt;font color=&quot;#9aa0b4&quot;&gt;95% total, 90% per package&lt;/font&gt;&lt;br&gt;GOWORK=off" vertex="1"><mxGeometry x="354" y="440" width="276" height="146" as="geometry"/></mxCell><mxCell id="c3" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="710" y="400" width="250" height="190" as="geometry"/></mxCell><mxCell id="c3-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="722" y="410" width="18" height="18" as="geometry"/></mxCell><mxCell id="c3-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="3 · Release" vertex="1"><mxGeometry x="748" y="411" width="200" height="18" as="geometry"/></mxCell><mxCell id="c3-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="434" as="sourcePoint"/><mxPoint x="950" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="release-please opens the release PR&lt;br&gt;merging it creates the tag, the GitHub release and the changelog" vertex="1"><mxGeometry x="724" y="440" width="226" height="146" as="geometry"/></mxCell><mxCell id="c4" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1030" y="400" width="400" height="190" as="geometry"/></mxCell><mxCell id="c4-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1042" y="410" width="18" height="18" as="geometry"/></mxCell><mxCell id="c4-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="4 · Build and publish (GoReleaser)" vertex="1"><mxGeometry x="1068" y="411" width="350" height="18" as="geometry"/></mxCell><mxCell id="c4-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="434" as="sourcePoint"/><mxPoint x="1420" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="runs on the tag, inside a reusable workflow&lt;br&gt;registry login first: &lt;font color=&quot;#9aa0b4&quot;&gt;azure/login or google-github-actions/auth (OIDC)&lt;/font&gt;&lt;br&gt;CLI: &lt;font color=&quot;#9aa0b4&quot;&gt;macOS, Linux and Windows binaries, archives, checksums, SBOMs (syft)&lt;/font&gt;&lt;br&gt;images: &lt;font color=&quot;#9aa0b4&quot;&gt;kos (ko) on cgr.dev/chainguard/static; linux/amd64, linux/arm64 optional; SPDX SBOM&lt;/font&gt;&lt;br&gt;cosign keyless: &lt;font color=&quot;#9aa0b4&quot;&gt;docker_signs (artifacts: manifests) for images, signs for the checksums&lt;/font&gt;&lt;br&gt;release.mode: &lt;font color=&quot;#9aa0b4&quot;&gt;keep-existing; changelog.disable: true&lt;/font&gt;" vertex="1"><mxGeometry x="1044" y="440" width="376" height="146" as="geometry"/></mxCell><mxCell id="c5" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1500" y="400" width="290" height="190" as="geometry"/></mxCell><mxCell id="c5-i" parent="1" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" value="" vertex="1"><mxGeometry x="1512" y="410" width="18" height="18" as="geometry"/></mxCell><mxCell id="c5-n" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;fontStyle=1;" value="5 · Helm chart" vertex="1"><mxGeometry x="1538" y="411" width="240" height="18" as="geometry"/></mxCell><mxCell id="c5-hr" parent="1" style="endArrow=none;html=1;strokeColor=#3a3f55;strokeWidth=1;" value="" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1510" y="434" as="sourcePoint"/><mxPoint x="1780" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5-f" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#e6e8f0;align=left;verticalAlign=top;spacing=0;" value="helm package, then helm push to oci:// in the same registry&lt;br&gt;chart version follows the release tag&lt;br&gt;cosign keyless signature on the chart digest" vertex="1"><mxGeometry x="1514" y="440" width="266" height="146" as="geometry"/></mxCell><mxCell id="c6" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#1d2030;strokeColor=#2ee6c5;strokeWidth=1.5;" value="" vertex="1"><mxGeometry x="1860" y="400" width="290" height="190" as="geometry"/></mxCell><mxCell id="c6-i" parent="1" style="shape=image;image=data